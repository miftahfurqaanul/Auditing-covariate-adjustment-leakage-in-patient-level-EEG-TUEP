\@writefile{lof}{\contentsline {figure}{\numberline {S3.1}{\ignorespaces Channels and the preprocessing workflow. (a) The nineteen electrodes of the 10--20 system are grouped into five regions; thick circles mark the eight channels shown in Fig.~\ref  {fig:sinyal}. (b) From the first-session clinical recording to the per-patient prediction: average reference, resampling to 200 Hz, 0.5--45 Hz filter, clean 10 s windows, three feature views (I2, P3, NM), then covariate adjustment and one prediction per patient. Codes are defined in Table~\ref  {tab:glosarium}.\relax }}{37}{figure.caption.59}\protected@file@percent }
\newlabel{fig:kanal}{{S3.1}{37}{Channels and the preprocessing workflow. (a) The nineteen electrodes of the 10--20 system are grouped into five regions; thick circles mark the eight channels shown in \figref {fig:sinyal}. (b) From the first-session clinical recording to the per-patient prediction: average reference, resampling to 200 Hz, 0.5--45 Hz filter, clean 10 s windows, three feature views (I2, P3, NM), then covariate adjustment and one prediction per patient. Codes are defined in \tabref {tab:glosarium}.\relax }{figure.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3.2}{\ignorespaces Example 10 s windows from the first session of a pair of patients matched on recording year (2013), device (X), sex (male), and age (72 and 73 years). Panels show (a) non-epilepsy and (b) epilepsy, with eight of the 19 channels on the same amplitude scale. The pair was chosen at random (seed 20261024) from 51 eligible pairs, and the window whose line length was closest to the median of the recording was chosen, not the one that looked most abnormal. No part is marked as a seizure: TUEP v2.0.1 contains only EDF files without seizure annotations or clinical reports, both windows come from routine interictal EEG, and this study classifies patients and does not detect seizures. Without clinical reading, the visible differences do not indicate a marker of epilepsy. TUEP, Temple University Hospital EEG Epilepsy Corpus; EDF, European Data Format.\relax }}{38}{figure.caption.60}\protected@file@percent }
\newlabel{fig:sinyal}{{S3.2}{38}{Example 10 s windows from the first session of a pair of patients matched on recording year (2013), device (X), sex (male), and age (72 and 73 years). Panels show (a) non-epilepsy and (b) epilepsy, with eight of the 19 channels on the same amplitude scale. The pair was chosen at random (seed 20261024) from 51 eligible pairs, and the window whose line length was closest to the median of the recording was chosen, not the one that looked most abnormal. No part is marked as a seizure: TUEP v2.0.1 contains only EDF files without seizure annotations or clinical reports, both windows come from routine interictal EEG, and this study classifies patients and does not detect seizures. Without clinical reading, the visible differences do not indicate a marker of epilepsy. TUEP, Temple University Hospital EEG Epilepsy Corpus; EDF, European Data Format.\relax }{figure.caption.60}{}}
