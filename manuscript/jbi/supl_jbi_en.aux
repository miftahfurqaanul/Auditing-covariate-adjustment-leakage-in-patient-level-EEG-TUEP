\@writefile{lof}{\contentsline {figure}{\numberline {S3.3}{\ignorespaces (a) Difference in per-fold AUC between models with and without covariate adjustment for the three views and the combined mean of the three (dots: 50 folds, diamond and bar: mean with Nadeau--Bengio corrected 95\% CI, dashed line: zero). (b) AUC of F2, I2, C1, and the acquisition-metadata baseline within strata that compare only patients with and without epilepsy from the same stratum. Scores were averaged over 10 repetitions before computing the AUC, which gives higher values than the per-fold AUC (S1.3). AUC, area under the receiver operating characteristic curve; CI, confidence interval. Codes are defined in Table~\ref  {tab:glosarium}.\relax }}{40}{figure.caption.65}\protected@file@percent }
\newlabel{fig:penyesuaian}{{S3.3}{40}{(a) Difference in per-fold AUC between models with and without covariate adjustment for the three views and the combined mean of the three (dots: 50 folds, diamond and bar: mean with Nadeau--Bengio corrected 95\% CI, dashed line: zero). (b) AUC of F2, I2, C1, and the acquisition-metadata baseline within strata that compare only patients with and without epilepsy from the same stratum. Scores were averaged over 10 repetitions before computing the AUC, which gives higher values than the per-fold AUC (S1.3). AUC, area under the receiver operating characteristic curve; CI, confidence interval. Codes are defined in \tabref {tab:glosarium}.\relax }{figure.caption.65}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3.4}{\ignorespaces Case study on the TUEP label (50 canonical folds). (a) Per-fold AUC with Nadeau--Bengio corrected 95\% CI for the audited pipeline, its spectral view, the model without adjustment, the non-EEG model (N0), N0 plus the adjusted EEG features (N1, strict nesting), and the two baselines without EEG. Dashed line, AUC 50; dotted line, acquisition-metadata baseline. (b) Tested differences in per-fold AUC with 95\% CI and $p$ from the corrected $t$-test (Table~\ref  {tab:uji}). AUC, area under the receiver operating characteristic curve; CI, confidence interval; TUEP, Temple University Hospital EEG Epilepsy Corpus. Codes are defined in Table~\ref  {tab:glosarium}.\relax }}{40}{figure.caption.66}\protected@file@percent }
\newlabel{fig:kasus}{{S3.4}{40}{Case study on the TUEP label (50 canonical folds). (a) Per-fold AUC with Nadeau--Bengio corrected 95\% CI for the audited pipeline, its spectral view, the model without adjustment, the non-EEG model (N0), N0 plus the adjusted EEG features (N1, strict nesting), and the two baselines without EEG. Dashed line, AUC 50; dotted line, acquisition-metadata baseline. (b) Tested differences in per-fold AUC with 95\% CI and $p$ from the corrected $t$-test (\tabref {tab:uji}). AUC, area under the receiver operating characteristic curve; CI, confidence interval; TUEP, Temple University Hospital EEG Epilepsy Corpus. Codes are defined in \tabref {tab:glosarium}.\relax }{figure.caption.66}{}}
