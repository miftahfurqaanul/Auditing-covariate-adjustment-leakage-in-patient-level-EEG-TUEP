\@writefile{lot}{\contentsline {table}{\numberline {S2.11}{\ignorespaces Plasmode on the independent Emotiv cohort (round 50, 299 subjects, H1): per-fold AUC (percent, replicate mean) by $\gamma $, the paired difference at $\gamma =1$ against the same transformation without adjustment (the raw pipeline for the tree classifiers, in pp with 95\% CI over replicates), and the R1 and R2 decisions at $\gamma =1$. Replicates: 30 (random forest, logistic regression) and 20 (XGBoost).\relax }}{21}{table.caption.26}\protected@file@percent }
\newlabel{tab:s2_emotiv}{{S2.11}{21}{Plasmode on the independent Emotiv cohort (round 50, 299 subjects, H1): per-fold AUC (percent, replicate mean) by $\gamma $, the paired difference at $\gamma =1$ against the same transformation without adjustment (the raw pipeline for the tree classifiers, in pp with 95\% CI over replicates), and the R1 and R2 decisions at $\gamma =1$. Replicates: 30 (random forest, logistic regression) and 20 (XGBoost).\relax }{table.caption.26}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2.12}{\ignorespaces Plasmode: real EEG features with synthetic labels derived from covariates alone (between-patient shuffle, H1: features swapped between patients); upper blocks TUEP, lower block the independent Emotiv cohort. Per-fold AUC (percent, replicate mean) by label--covariate association strength $\gamma $ ($\gamma =1$ mimics the real association). The last two columns: the absolute-rule decision and the paired difference in pp (paired-rule decision) at $\gamma =1$ against the raw pipeline without adjustment for the tree classifiers, the window-level logistic regressions, and NM, and against the same transformation without adjustment otherwise (rows ``rank-normal, no adjustment''); its Monte Carlo SE was 0.3--0.9 pp, except 0.7--1.9 pp for raw adjustment with trees or the Bi-LSTM. For the tree classifiers and the window-level logistic regressions, the differences after a transformation are taken against the raw unadjusted pipeline and so also contain the effect of the transformation itself; round 57 added the transformed pipelines without adjustment, and Table~\ref  {tab:s2_p57} gives the adjustment effect within each transformation (as plotted in Fig.~\ref  {fig:plasmode}). For NM, no transformed pipeline without adjustment was run. Absolute rule (R1): no evidence if the mean $\leq 52.0$ and the mean $+\,1.645\,\mathrm  {SE} \leq 54.0$, leakage if $> 55$; paired rule (R2): no evidence if the difference $\leq 1.0$ pp (upper bound $\leq 3.0$ pp), leakage if $> 3.0$ pp; otherwise uncertain; ``--'': baseline row, no decision. Replicates: TUEP random forest and XGBoost 120 at $\gamma \in \{0,1\}$ (the 30 and 20 planned replicates plus the later extension, with the symlog, log, and rank-normal rows as a descriptive extension outside the plan, S2.11) and 30 and 20 at $\gamma =0.5$; TUEP logistic regression 30, Bi-LSTM and NM 20 (only $\gamma \in \{0,1\}$); Emotiv 30 (random forest, logistic regression) and 20 (XGBoost). $^{\ddagger }$ CPU, same histogram algorithm (S2). Rows marked round 53: logistic regression on the raw window features of the tree classifiers, with the same labels, folds, and training patients (S2.12).\relax }}{26}{table.caption.27}\protected@file@percent }
\newlabel{tab:plasmode}{{S2.12}{26}{Plasmode: real EEG features with synthetic labels derived from covariates alone (between-patient shuffle, H1: features swapped between patients); upper blocks TUEP, lower block the independent Emotiv cohort. Per-fold AUC (percent, replicate mean) by label--covariate association strength $\gamma $ ($\gamma =1$ mimics the real association). The last two columns: the absolute-rule decision and the paired difference in pp (paired-rule decision) at $\gamma =1$ against the raw pipeline without adjustment for the tree classifiers, the window-level logistic regressions, and NM, and against the same transformation without adjustment otherwise (rows ``rank-normal, no adjustment''); its Monte Carlo SE was 0.3--0.9 pp, except 0.7--1.9 pp for raw adjustment with trees or the Bi-LSTM. For the tree classifiers and the window-level logistic regressions, the differences after a transformation are taken against the raw unadjusted pipeline and so also contain the effect of the transformation itself; round 57 added the transformed pipelines without adjustment, and \tabref {tab:s2_p57} gives the adjustment effect within each transformation (as plotted in \figref {fig:plasmode}). For NM, no transformed pipeline without adjustment was run. Absolute rule (R1): no evidence if the mean $\leq 52.0$ and the mean $+\,1.645\,\mathrm {SE} \leq 54.0$, leakage if $> 55$; paired rule (R2): no evidence if the difference $\leq 1.0$ pp (upper bound $\leq 3.0$ pp), leakage if $> 3.0$ pp; otherwise uncertain; ``--'': baseline row, no decision. Replicates: TUEP random forest and XGBoost 120 at $\gamma \in \{0,1\}$ (the 30 and 20 planned replicates plus the later extension, with the symlog, log, and rank-normal rows as a descriptive extension outside the plan, S2.11) and 30 and 20 at $\gamma =0.5$; TUEP logistic regression 30, Bi-LSTM and NM 20 (only $\gamma \in \{0,1\}$); Emotiv 30 (random forest, logistic regression) and 20 (XGBoost). $^{\ddagger }$ CPU, same histogram algorithm (S2). Rows marked round 53: logistic regression on the raw window features of the tree classifiers, with the same labels, folds, and training patients (S2.12).\relax }{table.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2.13}{\ignorespaces Round 53: leak of the tree classifier minus leak of window-level logistic regression on the same raw window features (raw per-patient adjustment minus raw without adjustment, $\gamma =1$, H1, per-fold AUC in pp), paired by replicate. One-sided $t$-test ($H_1$: difference $>0$); Holm within each family (two tests).\relax }}{27}{table.caption.29}\protected@file@percent }
\newlabel{tab:s2_p53}{{S2.13}{27}{Round 53: leak of the tree classifier minus leak of window-level logistic regression on the same raw window features (raw per-patient adjustment minus raw without adjustment, $\gamma =1$, H1, per-fold AUC in pp), paired by replicate. One-sided $t$-test ($H_1$: difference $>0$); Holm within each family (two tests).\relax }{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2.14}{\ignorespaces Round 55: leak of the control-referenced adjustment (V0 form) in the control-reference simulation, mean paired difference in pooled AUC (pp) over 100 replicates, with the paired-rule decision in brackets (N: no evidence, U: uncertain, L: leakage), by design, label--covariate association $s$, and number of training controls per fold. Last column: the same difference for the all-patient adjustment (V4 form), from 20 to 1,000 controls. Monte Carlo 95\% CIs are in the repository (S1.7).\relax }}{27}{table.caption.31}\protected@file@percent }
\newlabel{tab:s2_p55}{{S2.14}{27}{Round 55: leak of the control-referenced adjustment (V0 form) in the control-reference simulation, mean paired difference in pooled AUC (pp) over 100 replicates, with the paired-rule decision in brackets (N: no evidence, U: uncertain, L: leakage), by design, label--covariate association $s$, and number of training controls per fold. Last column: the same difference for the all-patient adjustment (V4 form), from 20 to 1,000 controls. Monte Carlo 95\% CIs are in the repository (S1.7).\relax }{table.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2.15}{\ignorespaces Round 56: real null test of the I2 pipeline without age and sex (between-patient shuffle, 100 replicates identical to round 29). Pooled AUC: mean (SD) over replicates; per-fold: mean per-fold AUC; difference from C1 in pp: mean (SD).\relax }}{27}{table.caption.33}\protected@file@percent }
\newlabel{tab:s2_p56}{{S2.15}{27}{Round 56: real null test of the I2 pipeline without age and sex (between-patient shuffle, 100 replicates identical to round 29). Pooled AUC: mean (SD) over replicates; per-fold: mean per-fold AUC; difference from C1 in pp: mean (SD).\relax }{table.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2.16}{\ignorespaces Round 57: four-cell estimand at $\gamma =1$ (per-fold AUC in percent, replicate means). $T$: transformation; A: per-patient adjustment. Last columns: pure adjustment effect $T+\mathrm  {A}-T$ (pp, Monte Carlo 95\% CI) and its paired-rule decision. Replicates: TUEP trees and LR 120, Emotiv random forest and LR 30, XGBoost 20.\relax }}{27}{table.caption.35}\protected@file@percent }
\newlabel{tab:s2_p57}{{S2.16}{27}{Round 57: four-cell estimand at $\gamma =1$ (per-fold AUC in percent, replicate means). $T$: transformation; A: per-patient adjustment. Last columns: pure adjustment effect $T+\mathrm {A}-T$ (pp, Monte Carlo 95\% CI) and its paired-rule decision. Replicates: TUEP trees and LR 120, Emotiv random forest and LR 30, XGBoost 20.\relax }{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2.17}{\ignorespaces Round 58: leak (per-fold AUC with minus without per-patient adjustment in pp, with Monte Carlo 95\% CI) of window-level logistic regression by training patients, window weights, and aggregation of window scores.\relax }}{28}{table.caption.37}\protected@file@percent }
\newlabel{tab:s2_p58}{{S2.17}{28}{Round 58: leak (per-fold AUC with minus without per-patient adjustment in pp, with Monte Carlo 95\% CI) of window-level logistic regression by training patients, window weights, and aggregation of window scores.\relax }{table.caption.37}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2.18}{\ignorespaces Round 60: decisions of the combined rule in independent audits of new simulation replicates (counts of no evidence/uncertain/leakage in 10, 4, and 2 audits of 20, 50, and 100 replicates per cell). New mean: mean paired difference over the 200 new replicates (pp). Last column: paired-rule leakage frequency predicted for 20 replicates from the stored pool of the same cell.\relax }}{28}{table.caption.40}\protected@file@percent }
\newlabel{tab:s2_p60}{{S2.18}{28}{Round 60: decisions of the combined rule in independent audits of new simulation replicates (counts of no evidence/uncertain/leakage in 10, 4, and 2 audits of 20, 50, and 100 replicates per cell). New mean: mean paired difference over the 200 new replicates (pp). Last column: paired-rule leakage frequency predicted for 20 replicates from the stored pool of the same cell.\relax }{table.caption.40}{}}
