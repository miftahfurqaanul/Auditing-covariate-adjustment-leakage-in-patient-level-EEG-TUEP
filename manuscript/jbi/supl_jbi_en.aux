\@writefile{lof}{\contentsline {figure}{\numberline {S3.4}{\ignorespaces Case study on the TUEP label (50 canonical folds). (a) Per-fold AUC with Nadeau--Bengio corrected 95\% CI for the audited pipeline, its spectral view, the model without adjustment, the non-EEG model (N0), N0 plus the adjusted EEG features (N1, strict nesting), and the two baselines without EEG; dashed line: AUC 50; dotted line: acquisition-metadata baseline. (b) Tested differences in per-fold AUC with 95\% CI and $p$ from the corrected $t$-test (Table~\ref  {tab:uji}).\relax }}{35}{figure.caption.56}\protected@file@percent }
\newlabel{fig:kasus}{{S3.4}{35}{Case study on the TUEP label (50 canonical folds). (a) Per-fold AUC with Nadeau--Bengio corrected 95\% CI for the audited pipeline, its spectral view, the model without adjustment, the non-EEG model (N0), N0 plus the adjusted EEG features (N1, strict nesting), and the two baselines without EEG; dashed line: AUC 50; dotted line: acquisition-metadata baseline. (b) Tested differences in per-fold AUC with 95\% CI and $p$ from the corrected $t$-test (\tabref {tab:uji}).\relax }{figure.caption.56}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3.8}{\ignorespaces Selection-optimism correction and max-T test on stored out-of-fold predictions (class-stratified patient bootstrap with 2,000 replicates, pooled AUC in percent). Optimism is the mean difference between the in-bag AUC and the out-of-sample AUC for the in-bag winner; the corrected AUC is the full AUC minus optimism. Max-T test (studentized Reality Check): no candidate is better than the reference; Holm over two references 0.72 (main set) and 1.00 (all). This is a sensitivity analysis of selection conditional on the stored candidates: it does not repeat the adaptive process that produced them, so the corrected AUC is not free of all development bias and is not an independent validation.\relax }}{35}{table.caption.59}\protected@file@percent }
\newlabel{tab:optimisme}{{S3.8}{35}{Selection-optimism correction and max-T test on stored out-of-fold predictions (class-stratified patient bootstrap with 2,000 replicates, pooled AUC in percent). Optimism is the mean difference between the in-bag AUC and the out-of-sample AUC for the in-bag winner; the corrected AUC is the full AUC minus optimism. Max-T test (studentized Reality Check): no candidate is better than the reference; Holm over two references 0.72 (main set) and 1.00 (all). This is a sensitivity analysis of selection conditional on the stored candidates: it does not repeat the adaptive process that produced them, so the corrected AUC is not free of all development bias and is not an independent validation.\relax }{table.caption.59}{}}
