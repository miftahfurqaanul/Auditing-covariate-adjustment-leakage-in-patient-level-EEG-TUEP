\@writefile{lof}{\contentsline {figure}{\numberline {S3.1}{\ignorespaces Channels and the preprocessing workflow. (a) The nineteen electrodes of the 10--20 system are grouped into five regions; thick circles mark the eight channels shown in Fig.~\ref  {fig:sinyal}. (b) From the first-session clinical recording to the per-patient prediction: average reference, resampling to 200 Hz, 0.5--45 Hz filter, clean 10 s windows, three feature views (I2, P3, NM), then covariate adjustment and one prediction per patient.\relax }}{31}{figure.caption.49}\protected@file@percent }
\newlabel{fig:kanal}{{S3.1}{31}{Channels and the preprocessing workflow. (a) The nineteen electrodes of the 10--20 system are grouped into five regions; thick circles mark the eight channels shown in \figref {fig:sinyal}. (b) From the first-session clinical recording to the per-patient prediction: average reference, resampling to 200 Hz, 0.5--45 Hz filter, clean 10 s windows, three feature views (I2, P3, NM), then covariate adjustment and one prediction per patient.\relax }{figure.caption.49}{}}
\citation{bh1995}
\@writefile{lof}{\contentsline {figure}{\numberline {S3.2}{\ignorespaces Example 10 s windows from the first session of a pair of patients matched on recording year (2013), device (X), sex (male), and age (72 and 73 years): (a) non-epilepsy and (b) epilepsy; eight of the 19 channels, same amplitude scale. The pair was chosen at random (seed 20261024) from 51 eligible pairs, and the window whose line length was closest to the median of the recording was chosen, not the one that looked most abnormal. No part is marked as a seizure: TUEP v2.0.1 contains only EDF files without seizure annotations or clinical reports, both windows come from routine interictal EEG, and this study classifies patients and does not detect seizures. The visible differences cannot be interpreted as a marker of epilepsy without clinical reading.\relax }}{32}{figure.caption.50}\protected@file@percent }
\newlabel{fig:sinyal}{{S3.2}{32}{Example 10 s windows from the first session of a pair of patients matched on recording year (2013), device (X), sex (male), and age (72 and 73 years): (a) non-epilepsy and (b) epilepsy; eight of the 19 channels, same amplitude scale. The pair was chosen at random (seed 20261024) from 51 eligible pairs, and the window whose line length was closest to the median of the recording was chosen, not the one that looked most abnormal. No part is marked as a seizure: TUEP v2.0.1 contains only EDF files without seizure annotations or clinical reports, both windows come from routine interictal EEG, and this study classifies patients and does not detect seizures. The visible differences cannot be interpreted as a marker of epilepsy without clinical reading.\relax }{figure.caption.50}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3.6}{\ignorespaces Performance of from-scratch models with covariate adjustment and non-EEG baselines under the patient-level protocol with 50 canonical folds. AUC in percent; the 95\% CI of the per-fold AUC is Nadeau--Bengio corrected and the CI of the pooled AUC uses patient-level bootstrap; metrics at the 0.5 threshold are descriptive and averaged over 10 repetitions. I2, P3, NM, F2, and C1 include age and sex. N0--N2 use strict nesting (round 49). Sens is sensitivity, Spec specificity, BAC balanced accuracy, and NA not available.\relax }}{33}{table.caption.53}\protected@file@percent }
\newlabel{tab:utama}{{S3.6}{33}{Performance of from-scratch models with covariate adjustment and non-EEG baselines under the patient-level protocol with 50 canonical folds. AUC in percent; the 95\% CI of the per-fold AUC is Nadeau--Bengio corrected and the CI of the pooled AUC uses patient-level bootstrap; metrics at the 0.5 threshold are descriptive and averaged over 10 repetitions. I2, P3, NM, F2, and C1 include age and sex. N0--N2 use strict nesting (round 49). Sens is sensitivity, Spec specificity, BAC balanced accuracy, and NA not available.\relax }{table.caption.53}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3.7}{\ignorespaces Differences in per-fold AUC in pp (mean of 50 folds, 95\% CI and $p$ from the Nadeau--Bengio corrected $t$-test). $q$ is the BH value over the 22 tests of this analysis; the tests against published methods and foundation models are not reported (S1.5).\relax }}{34}{table.caption.54}\protected@file@percent }
\newlabel{tab:uji}{{S3.7}{34}{Differences in per-fold AUC in pp (mean of 50 folds, 95\% CI and $p$ from the Nadeau--Bengio corrected $t$-test). $q$ is the BH value over the 22 tests of this analysis; the tests against published methods and foundation models are not reported (S1.5).\relax }{table.caption.54}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3.3}{\ignorespaces (a) Difference in per-fold AUC between models with and without covariate adjustment for the three views and their combined mean (dots: 50 folds, diamond and bar: mean with Nadeau--Bengio corrected 95\% CI, dashed line: zero). (b) AUC of F2, I2, C1, and the acquisition-metadata baseline within strata that compare only patients with and without epilepsy from the same stratum; scores were averaged over 10 repetitions before computing the AUC, which gives higher values than the per-fold AUC (S1.3).\relax }}{34}{figure.caption.55}\protected@file@percent }
\newlabel{fig:penyesuaian}{{S3.3}{34}{(a) Difference in per-fold AUC between models with and without covariate adjustment for the three views and their combined mean (dots: 50 folds, diamond and bar: mean with Nadeau--Bengio corrected 95\% CI, dashed line: zero). (b) AUC of F2, I2, C1, and the acquisition-metadata baseline within strata that compare only patients with and without epilepsy from the same stratum; scores were averaged over 10 repetitions before computing the AUC, which gives higher values than the per-fold AUC (S1.3).\relax }{figure.caption.55}{}}
